# ─── AI ──────────────────────────────────────────────────────────────────────
# Gemini 2.0 Flash — used for company detection and brief synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Search ───────────────────────────────────────────────────────────────────
# Serper — Google Search API (https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# ─── Financial Filings ────────────────────────────────────────────────────────
# Companies House — UK company data (https://developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key_here

# OpenCorporates — Global company registry (https://api.opencorporates.com)
OPENCORPORATES_API_KEY=your_opencorporates_api_key_here

# SEC EDGAR — US company data is accessed without an API key
# (rate limit: 10 requests/second — Brief stays well under this)

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Required for share links and 6h brief caching
# Create a project at https://supabase.com and run supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── App ──────────────────────────────────────────────────────────────────────
# Used to generate shareable URLs
NEXT_PUBLIC_APP_URL=https://your-app-url.vercel.app
